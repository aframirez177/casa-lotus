# Casa Lotus · platform API. Copy to .env on the server (never commit .env: this repo is public).

# ── basics ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://casalotus.studio
LOG_LEVEL=info
# sheets (production) | memoria (development only: a fake studio)
DATOS=sheets
SQLITE_PATH=/app/data/casalotus.db
# maintenance jobs (expire holds every 10 min, calendar daily at 03:00 Bogotá)
TAREAS=1

# ── Google Sheet «Casa Lotus · Sistema» (Sheets API, service account) ──
SHEET_ID=1mf4n7Yj9buyafjedw8zHMfoGG0yraaLcZ_DWGMc3xdo
# the service account key JSON, base64 encoded:  base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=
# …or a path to the key file inside the container (mount it read-only)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Google Ads offline conversions (Data Manager) ─────
# A SEPARATE spreadsheet «Casa Lotus · Conversiones Ads», owned by the studio account, shared with the
# service account as Editor. The API appends to its FIRST tab (the only one Data Manager reads) and keeps
# a rolling 90 days. Empty → rows go to the «Conversiones Ads» tab of the operating Sheet (fallback).
CONVERSIONES_SHEET_ID=

# ── e-mail (booking alert to «Correo para avisos», clienta codes, password resets) ──
# console (logs only) | smtp
CORREO_DRIVER=smtp
CORREO_REMITENTE=Casa Lotus <casalotusbogota@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=casalotusbogota@gmail.com
# a Gmail «app password» (Google account → Security → 2-Step Verification → App passwords)
SMTP_PASS=

# ── Web Push for Ana's installed app (npm run vapid prints a pair) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:casalotusbogota@gmail.com

# ── WhatsApp Cloud API (Meta). Empty = not connected: the API answers 503 «no-configurado» there ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# desconectado | prueba | produccion
WHATSAPP_MODO=

# ── network ────────────────────────────────────────────
# Proxies whose X-Forwarded-For is trusted. Default: private ranges (Caddy on the docker network)
# + Cloudflare's published ranges. Comma-separated CIDRs or names (loopback, uniquelocal).
TRUST_PROXY=
# development only: extra origins allowed by CORS (default http://localhost:5180 and :4321)
CORS_ORIGENES=
