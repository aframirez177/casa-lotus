{
  "name": "casa-lotus-server",
  "version": "2.0.0",
  "private": true,
  "description": "Casa Lotus platform API: Express 5 over the Google Sheet (business record) and SQLite (system internals).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch scripts/dev.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'tests/**/*.test.mjs'",
    "vapid": "node scripts/vapid.mjs",
    "crear-admin": "node --disable-warning=ExperimentalWarning scripts/crear-admin.mjs"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "nodemailer": "^10.0.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  }
}
