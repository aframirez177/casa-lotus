---
// Home: visual and motion parity with v1 (web/src/index.html), now with booking in the app and
// nav links to the inner pages.
import Base from "../layouts/Base.astro";
import Hero from "../components/secciones/Hero.astro";
import Manifiesto from "../components/secciones/Manifiesto.astro";
import Clases from "../components/secciones/Clases.astro";
import Sala from "../components/secciones/Sala.astro";
import PrimeraClase from "../components/secciones/PrimeraClase.astro";
import Horarios from "../components/secciones/Horarios.astro";
import Planes from "../components/secciones/Planes.astro";
import Metodo from "../components/secciones/Metodo.astro";
import Testimonios from "../components/secciones/Testimonios.astro";
import Preguntas from "../components/secciones/Preguntas.astro";
import Cierre from "../components/ui/Cierre.astro";
import { PAGINAS } from "../data/paginas";
const p = PAGINAS.inicio;
---
<Base pagina={p}>
  <Hero pagina={p} />
  <Manifiesto />
  <Clases />
  <Sala />
  <PrimeraClase />
  <Horarios />
  <Planes />
  <Metodo />
  <Testimonios />
  <Preguntas items={p.faq} />
  <Cierre ref="WEB-CIERRE" />
  <!-- paper veil: when the ribbon lands, four paper discs stack up on the infinity's crossing, grow until they
       cover the screen, then open from the centre and reveal the page. scripts/entrada.js paints it. -->
  <div slot="final" class="paper-veil" aria-hidden="true"></div>
</Base>
