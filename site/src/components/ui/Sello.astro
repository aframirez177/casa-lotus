---
// The official AÉREO® logo, untouched (licensed mark: never redrawn, only re-encoded and sized), next to what it certifies.
import { Picture } from "astro:assets";
import aereo from "../../assets/images/aereo-negro.png";
interface Props { grande?: boolean; reveal?: boolean }
const { grande = false, reveal = true } = Astro.props;
---
<div class:list={["seal", { "seal--big": grande }]} data-reveal={reveal ? true : undefined}>
  <Picture class="seal__logo" src={aereo} widths={[160, 240, 320, 400]} sizes="(max-width: 480px) 150px, 220px" formats={["avif"]} fallbackFormat="webp" alt="AÉREO®, método de entrenamiento" loading="lazy" decoding="async" />
  <span class="seal__label">Centro<br>autorizado</span>
</div>
