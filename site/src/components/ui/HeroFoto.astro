---
// The visual beside an inner H1: a photo in its class-colour field, with a tag.
import Foto from "./Foto.astro";
import type { ImageMetadata } from "astro";
interface Props { src: ImageMetadata; alt: string; color?: string; tag?: string }
const { src, alt, color = "var(--c-multinivel)", tag } = Astro.props;
---
<figure class="hero-media" style={`--c: ${color}; --i: 2`} data-in>
  <div class="hero-media__frame">
    <Foto src={src} alt={alt} sizes="(max-width: 900px) 92vw, 440px" widths={[400, 600, 880, 1050]} prioridad />
  </div>
  {tag && <figcaption class="tag hero-media__tag">{tag}</figcaption>}
</figure>
