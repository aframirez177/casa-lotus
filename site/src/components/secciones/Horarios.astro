---
// Schedule. Ships the weekly grid as HTML (works with no JavaScript and when the API is down);
// scripts/horarios.js repaints it with live availability from /api/publico/disponibilidad:
// next date per slot (modo "semana") or every class of the next three weeks (modo "lista").
// Swings fill as bookings arrive; the text never states a number.
import { reservar } from "../../lib/enlaces";
import { HORARIO_SEMANAL, DIAS, POLITICAS, refHorario, hora12 } from "../../data/estudio";

interface Props {
  modo?: "semana" | "lista";
  cabeza?: boolean;
  eyebrow?: string;
  titulo?: string;
  lead?: string;
}
const {
  modo = "semana",
  cabeza = true,
  eyebrow = "Horarios",
  titulo = "Cupos limitados, a propósito.",
  lead = "Las clases son semipersonalizadas: cupos limitados para que tu profe esté pendiente de ti. Si el horario que buscas no aparece, escríbenos; estamos abriendo clases nuevas.",
} = Astro.props;
const dias = DIAS.filter((d) => HORARIO_SEMANAL.some((f) => f.dia === d));
---
<section class:list={["section schedule", { "section--first": !cabeza }]} id="horarios" data-bg="paper">
  <div class="wrap">
    {cabeza && (
      <header class="section__head" data-float>
        <p class="eyebrow" data-reveal>{eyebrow}</p>
        <h2 class="display h2" data-split>{titulo}</h2>
        <p class="lead section__lead" data-reveal>{lead}</p>
      </header>
    )}

    {!cabeza && <h2 class="sr-only">Horario de clases</h2>}
    <!-- is-static: the weekly template, until the live availability replaces it (no swings: they would claim free spots) -->
    <div class="days is-static" data-horario={modo}>
      {dias.map((dia) => (
        <div class="day" data-reveal>
          <h3 class="day__name">{dia}</h3>
          {HORARIO_SEMANAL.filter((f) => f.dia === dia).map((f) => {
            const ref = refHorario(f.dia, f.hora);
            const { hora, sufijo } = hora12(f.hora);
            return (
              <a class="slot" data-cta={ref} href={reservar(ref)} data-cursor="Reservar">
                <span class="slot__time">{hora}<small>{sufijo}</small></span>
                <span class="slot__meta">{f.clase && <span class="slot__class">{f.clase}</span>}<span class="swings" data-taken="0" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></span>
                <span class="slot__go" aria-hidden="true"></span>
              </a>
            );
          })}
        </div>
      ))}
    </div>
    <p class="horario-estado" data-horario-estado="semanal"><span class="horario-estado__dot" aria-hidden="true"></span><span data-horario-texto>Horario de la semana</span></p>
    {modo === "lista" && (
      <p class="leyenda" data-leyenda hidden aria-hidden="true"><span><i></i> Columpio libre</span><span><i class="is-taken"></i> Columpio tomado</span></p>
    )}
    <p class="note" data-reveal>Reserva hasta {POLITICAS.horasReservar} horas antes. No hay clases los días festivos.</p>
  </div>
</section>
