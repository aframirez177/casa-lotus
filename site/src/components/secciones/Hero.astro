---
// Home hero (v1 parity): headline, one line, one button; the mark enters as a ribbon (sitio.js).
import Seda from "../ui/Seda.astro";
import { reservar } from "../../lib/enlaces";
import { PRUEBA } from "../../data/estudio";
import type { Pagina } from "../../data/paginas";
interface Props { pagina: Pagina }
const { pagina } = Astro.props;
const centre = "343.6,536.1 326.7,529.8 315.5,525.6 304.2,521.5 292.9,517.5 281.4,513.9 269.9,510.7 258.3,507.7 246.5,505.1 234.8,502.9 222.9,501.0 211.0,499.5 199.1,498.4 187.1,497.6 175.1,497.2 163.1,497.3 151.1,497.9 139.2,498.9 127.3,500.6 115.5,503.0 103.9,506.2 92.7,510.2 81.8,515.4 71.6,521.7 62.3,529.2 54.2,538.1 47.6,548.1 42.8,559.0 39.8,570.7 38.9,582.6 39.9,594.5 42.9,606.2 47.7,617.2 54.0,627.3 61.6,636.6 70.2,644.9 79.7,652.3 89.8,658.8 100.3,664.6 111.2,669.5 122.4,673.9 133.8,677.5 145.4,680.6 157.2,683.1 169.0,685.0 180.9,686.3 192.9,687.1 204.9,687.3 216.9,687.0 228.9,686.1 240.8,684.5 252.6,682.4 264.3,679.7 275.8,676.5 287.3,672.8 298.5,668.6 309.6,664.0 320.5,659.0 331.2,653.6 341.8,647.9 352.2,642.0 362.4,635.8 372.6,629.4 382.6,622.8 392.6,616.1 402.4,609.2 412.3,602.3 422.0,595.4 431.8,588.4 441.5,581.4 451.3,574.4 461.1,567.5 470.9,560.6 480.9,553.9 490.9,547.3 501.0,540.8 511.3,534.6 521.6,528.6 532.2,522.8 542.8,517.3 553.7,512.1 564.6,507.3 575.8,502.9 587.1,498.9 598.6,495.4 610.2,492.4 621.9,489.8 633.8,487.8 645.7,486.3 657.6,485.4 669.6,485.0 681.6,485.2 693.6,485.9 705.5,487.1 717.4,489.0 729.1,491.6 740.6,494.8 751.9,498.9 762.8,503.9 773.3,509.9 783.1,516.8 792.1,524.6 800.3,533.4 807.5,543.0 813.7,553.2 818.7,564.1 822.4,575.6 824.7,587.3 825.4,599.3 824.4,611.3 821.9,623.0 818.0,634.3 812.8,645.1 806.5,655.3 799.2,664.8 791.1,673.7 782.3,681.8 772.9,689.3 763.0,696.1 752.6,702.2 741.9,707.5 730.9,712.3 719.6,716.3 708.1,719.6 696.4,722.3 684.5,724.3 672.6,725.7 660.6,726.4 648.6,726.4 636.7,725.8 624.7,724.7 612.8,723.0 601.0,720.9 589.3,718.5 577.6,715.7 566.0,712.7 554.5,709.3 543.0,705.7 531.7,701.8 520.4,697.7 509.2,693.3 498.1,688.9 488.1,684.8 471.4,678.0";
---
<section class="hero" id="inicio" data-bg="paper" data-silk-host>
  <Seda />
  <div class="hero__grid wrap">
    <div class="hero__copy">
      <!-- SEO plan: the H1 names the search intent; the brand line keeps the big display type (v1 look).
           Painted from the first frame (the LCP element): a CSS rise of 300 ms, no script waits on it. -->
      <p class="display hero__title" data-in style="--i:0">{pagina.lema}</p>
      <h1 class="lead hero__lead" data-in style="--i:1">{pagina.h1}.</h1>
      <div class="hero__actions" data-in style="--i:2">
        <a class="btn btn--primary" data-cta="WEB-HERO" data-magnetic data-cursor="Reservar" href={reservar("WEB-HERO", { plan: PRUEBA.nombre })}><span class="dot" aria-hidden="true"></span>{pagina.cta.texto}</a>
      </div>
    </div>
    <div class="hero__mark" aria-hidden="true">
      <!-- paper discs bloom behind the mark when the ribbon lands (scripts/entrada.js) -->
      <div class="paper-veil"></div>
      <svg class="lotus-draw__shadow" viewBox="-60 -60 985 883"><use href="#lotus-base"/><use href="#lotus-petalo-izq"/><use href="#lotus-petalo-der"/><use href="#lotus-centro"/></svg>
      <!-- entrance: a navy ribbon, as wide as the mark's stroke, flies in from off-screen and winds into the
           infinity (path built at runtime from data-centre so it always starts beyond the screen edge). -->
      <svg class="lotus-draw" viewBox="-60 -60 985 883" data-lotus-draw data-centre={centre}>
        <defs><path class="ribbon-measure" d=""/></defs>
        <path class="ribbon-fly" d=""/>
        <use class="lotus-part lotus-part--base" href="#lotus-base"/>
        <use class="lotus-part lotus-part--petal" href="#lotus-centro"/>
        <use class="lotus-part lotus-part--petal" href="#lotus-petalo-izq"/>
        <use class="lotus-part lotus-part--petal" href="#lotus-petalo-der"/>
      </svg>
    </div>
  </div>
</section>
<script>
  import "../../scripts/entrada.js";
</script>
